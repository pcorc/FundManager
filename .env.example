# Copy to .env (gitignored) and fill in. Read by config/database.py; the SMTP
# settings are read by notifications/email_manager.py.
DB_CONNECTION_STRING=mysql+pymysql://USER:PASSWORD@HOST:PORT/first_trust_usa
# FUNDMANAGER_SMTP_HOST=smtp.office365.com
# FUNDMANAGER_SMTP_PORT=587
# FUNDMANAGER_SMTP_USER=
# FUNDMANAGER_SMTP_PASSWORD=
# FUNDMANAGER_FROM_ADDRESS=
# FUNDMANAGER_EMAIL_MODE=display

# Web UI (ui/app.py). Runs always write to their own folder under the output root, never to G:.
# FUNDMANAGER_UI_OUTPUT_ROOT=C:\FundManager\ui_runs      # default: <repo>\ui_runs
# FUNDMANAGER_UI_PUBLISH_ROOT=G:\Shared drives\Portfolio Management\Funds\Archive\Daily_Compliance\2026  # unset = no Publish button
# FUNDMANAGER_UI_TIMEOUT_MINUTES=120                     # 0 = no timeout
# FUNDMANAGER_UI_USER_HEADER=X-Forwarded-User            # username header set by the SSO proxy
# FUNDMANAGER_UI_PASSWORD=                               # optional shared password (or in .streamlit/secrets.toml)
# FUNDMANAGER_UI_CATALOG_TTL=600                         # seconds the fund groups are cached
